[Unit]
Description=Mail sidecar API
After=network.target

[Service]
User=mailapi
Group=mailapi
WorkingDirectory=/opt/mailapi
EnvironmentFile=/etc/mailapi.env
StateDirectory=mailapi
ExecStart=/opt/mailapi/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
